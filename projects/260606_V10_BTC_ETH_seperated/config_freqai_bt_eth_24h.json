{
    "freqai": {
        "enabled": true,
        "purge_old_models": 2,
        "train_period_days": 365,
        "backtest_period_days": 1,
        "identifier": "opt_eth_24h",
        "feature_parameters": {
            "include_timeframes": [
                "4h"
            ],
            "include_corr_pairlist": [],
            "label_period_candles": 6,
            "indicator_periods_candles": [
                20
            ],
            "include_shifted_candles": 1,
            "DI_threshold": 0.9,
            "weight_factor": 0.7,
            "principal_component_analysis": false,
            "use_SVM_to_remove_outliers": false,
            "shuffle_after_split": true
        },
        "data_split_parameters": {
            "test_size": 0.2,
            "random_state": 42
        },
        "model_training_parameters": {
            "n_estimators": 150,
            "learning_rate": 0.05,
            "num_leaves": 31,
            "max_depth": -1,
            "min_child_samples": 20,
            "subsample": 0.8,
            "colsample_bytree": 0.8,
            "n_jobs": -1
        },
        "activate_tensorboard": false,
        "live_retrain_hours": 24
    }
}